{"surah":87,"words":{"87:1":["славь","имя","Господа твоего","Всевышнего"],
"87:2":["Который","сотворил","и соразмерил"],
"87:3":["и Который","предопределил","и наставил"],
"87:4":["и Который","вывел","пастбище"],
"87:5":["и сделал его","сором","тёмным"],
"87:6":["Мы дадим тебе прочесть","и не","забудешь ты"],
"87:7":["кроме","того, что","пожелает","Аллах","воистину, Он","знает","явное","и то, что","скрыто"],
"87:8":["и облегчим тебе путь","к легчайшему"],
"87:9":["так наставляй","если","приносит пользу","напоминание"],
"87:10":["воспримет назидание","тот, кто","страшится"],
"87:11":["и уклонится от него","самый несчастный"],
"87:12":["который","войдёт","в огонь","величайший"],
"87:13":["затем","не","умрёт он","там","и не","будет жить"],
"87:14":["уже","преуспел","тот, кто","очистился"],
"87:15":["и поминал","имя","Господа своего","и молился"],
"87:16":["но","вы предпочитаете","жизнь","ближнюю"],
"87:17":["а последняя жизнь","лучше","и долговечнее"],
"87:18":["воистину","это","непременно в","свитках","первых"],
"87:19":["свитках","Ибрахима","и Мусы"]}}
