{"surah":67,"words":{"67:1":["благословен","Тот, Который","в Чьей Руке","власть","и Он","над","каждой","вещью","Всемогущ"],
"67:2":["Который","сотворил","смерть","и жизнь","чтобы испытать вас","кто из вас","лучше","делами","и Он","Могущественный","Прощающий"],
"67:3":["Который","сотворил","семь","небес","одно над другим","не","увидишь ты","в","творении","Милостивого","никакой","несообразности","так обрати снова","взор","разве","видишь ты","какие-либо","трещины"],
"67:4":["затем","обрати снова","взор","дважды","вернётся","к тебе","взор","униженным","и он","утомлённый"],
"67:5":["и уже","украсили Мы","небо","ближнее","светильниками","и сделали их","орудиями метания","в шайтанов","и приготовили Мы","для них","мучение","Пламени"],
"67:6":["а для тех, которые","не уверовали","в Господа своего","мучение","Геенны","и скверно","место прибытия"],
"67:7":["когда","будут брошены","в неё","услышат они","от неё","рёв","а она","кипит"],
"67:8":["вот-вот","разорвётся","от","ярости","всякий раз, как","брошена","в неё","толпа","спросят их","её стражи","разве не","приходил к вам","предостерегающий"],
"67:9":["скажут они","да","уже","приходил к нам","предостерегающий","но мы сочли его лжецом","и сказали","не","ниспослал","Аллах","ни","одной вещи","не","вы","кроме как","в","заблуждении","большом"],
"67:10":["и скажут","если бы","мы","слушали","или","разумели","не","были бы мы","среди","обитателей","Пламени"],
"67:11":["и признали они","свой грех","так прочь","обитатели","Пламени"],
"67:12":["воистину","те, которые","боятся","Господа своего","не видя Его","для них","прощение","и награда","великая"],
"67:13":["и таите","ваши слова","или","говорите вслух","их","воистину, Он","Знающий","о том, что в","грудях"],
"67:14":["разве не","знает","Тот, Кто","сотворил","и Он","Проницательный","Сведущий"],
"67:15":["Он","Тот, Который","сделал","для вас","землю","покорной","так ходите","по","её просторам","и ешьте","из","Его удела","и к Нему","воскрешение"],
"67:16":["разве вы уверены","Тот, Кто (властвует)","на","небе","что не","заставит поглотить","вас","землю","и вот","она","колеблется"],
"67:17":["или","вы уверены","Тот, Кто (властвует)","на","небе","что не","нашлёт","на вас","ураган с камнями","и узнаете вы","каково","Моё предостережение"],
"67:18":["и уже","сочли ложью","те, которые","до","них","и каким же","было","Моё порицание"],
"67:19":["разве не","видели они","на","птиц","над ними","простирающих крылья","и складывающих","не","удерживает их","кроме","Милостивый","воистину, Он","всякую","вещь","видит"],
"67:20":["кто же","это","тот, который","он","войско","для вас","поможет вам","помимо","кроме","Милостивого","не","неверующие","кроме как","в","обольщении"],
"67:21":["кто же","это","тот, который","наделит вас уделом","если","удержит Он","Свой удел","но","упорствуют они","в","надменности","и отвращении"],
"67:22":["разве же тот, кто","идёт","ниц склонённым","на","лицо своё","вернее на пути","или тот, кто","идёт","выпрямившись","по","пути","прямому"],
"67:23":["скажи","Он","Тот, Который","создал вас","и сделал","для вас","слух","и зрение","и сердца","мало","как","вы благодарите"],
"67:24":["скажи","Он","Тот, Который","расселил вас","по","земле","и к Нему","вы будете собраны"],
"67:25":["и говорят они","когда","это","обещание","если","вы","правдивы"],
"67:26":["скажи","лишь","знание","у","Аллаха","и лишь","я","предостерегающий","ясный"],
"67:27":["и когда","увидят его","близким","омрачатся","лица","тех, которые","не уверовали","и будет сказано","это","то, что","вы","его","призывали"],
"67:28":["скажи","видели ли вы","если","погубит меня","Аллах","и тех, кто","со мной","или","помилует нас","то кто","защитит","неверующих","от","наказания","мучительного"],
"67:29":["скажи","Он","Милостивый","мы уверовали","в Него","и на Него","уповаем мы","и узнаете вы","кто","он","в","заблуждении","явном"],
"67:30":["скажи","видели ли вы","если","станет","ваша вода","ушедшей в землю","то кто","принесёт вам","воду","родниковую"]}}
