{"surah":92,"words":{"92:1":["клянусь ночью","когда","она покрывает"],
"92:2":["и днём","когда","он проясняется"],
"92:3":["и Тем, Кто","сотворил","мужской пол","и женский"],
"92:4":["воистину","стремления ваши","непременно различны"],
"92:5":["и что до","того, кто","давал","и был богобоязнен"],
"92:6":["и признавал истинным","наилучшее"],
"92:7":["то Мы облегчим ему путь","к легчайшему"],
"92:8":["а что до","того, кто","скупился","и считал себя не нуждающимся"],
"92:9":["и счёл ложью","наилучшее"],
"92:10":["то Мы облегчим ему путь","к тягчайшему"],
"92:11":["и не","поможет","ему","богатство его","когда","он падёт"],
"92:12":["воистину","на Нас","непременно руководство"],
"92:13":["и воистину","Нам","непременно последняя жизнь","и первая"],
"92:14":["и предостерёг я вас","от огня","пылающего"],
"92:15":["не","войдёт в него","кроме","самого несчастного"],
"92:16":["который","счёл ложью","и отвернулся"],
"92:17":["и будет удалён от него","самый богобоязненный"],
"92:18":["который","раздаёт","богатство своё","очищаясь"],
"92:19":["и нет","ни у кого","у него","никакой","милости","которая возмещается"],
"92:20":["кроме как","стремясь к","Лику","Господа его","Всевышнего"],
"92:21":["и непременно","он будет доволен"]}}
