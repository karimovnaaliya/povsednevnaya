{"surah":91,"words":{"91:1":["клянусь солнцем","и его сиянием"],
"91:2":["и луной","когда","она следует за ним"],
"91:3":["и днём","когда","он проявляет его"],
"91:4":["и ночью","когда","она покрывает его"],
"91:5":["и небом","и Тем, Кто","воздвиг его"],
"91:6":["и землёй","и Тем, Кто","распростёр её"],
"91:7":["и душой","и Тем, Кто","соразмерил её"],
"91:8":["и внушил ей","порочность её","и богобоязненность её"],
"91:9":["уже","преуспел","тот, кто","очистил её"],
"91:10":["и уже","потерпел урон","тот, кто","скрыл её"],
"91:11":["сочли ложью","самудяне","из-за своего беззакония"],
"91:12":["когда","вызвался","самый несчастный из них"],
"91:13":["и сказал","им","посланник","Аллаха","верблюдица","Аллаха","и её питьё"],
"91:14":["но они сочли его лжецом","и подрезали ей поджилки","и обрушил наказание","на них","Господь их","за грех их","и сровнял их"],
"91:15":["и не","боится Он","последствий этого"]}}
